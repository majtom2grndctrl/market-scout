# --- Secrets / env ---
# Never commit real secrets. Keep .env.example as the documented template.
.env
.env.*
!.env.example

# --- Go build artifacts ---
# Compiled binaries from `go build` / `go install`
/bin/
/dist/
/tmp/
*.exe
*.exe~
*.dll
*.so
*.dylib
# Test binaries and coverage output
*.test
*.out
coverage.txt
coverage.html
# Common output paths for the fetcher binary
/cmd/fetcher/fetcher
/fetcher

# --- Go module / tooling caches ---
# vendor/ is intentionally NOT ignored — uncomment if you adopt vendoring later.
# vendor/

# --- sqlc ---
# Generated sqlc code IS checked in (it's part of the typed API surface and
# enables building without running codegen). Do not ignore internal/db/**.

# --- golang-migrate ---
# Migration files are source of truth — keep them tracked.

# --- Next.js / Node (future web app) ---
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# Next.js build output
.next/
out/
next-env.d.ts

# Build / bundler output
build/
dist/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Test / coverage
/coverage/
.nyc_output/

# Vercel
.vercel

# TypeScript incremental build info
*.tsbuildinfo

# --- Docker / Postgres local volumes ---
# If docker-compose persists Postgres data into a bind-mounted folder,
# keep that data out of git.
/data/
/pgdata/
/postgres-data/
/.docker/
docker-compose.override.yml

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# --- JetBrains (GoLand / WebStorm / IntelliJ) ---
.idea/
*.iml
*.iws
*.ipr

# --- VS Code ---
# Allow shared editor settings if you choose to commit them; ignore personal cruft.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.history/

# --- Misc editor / OS ---
*.swp
*.swo
*~
.direnv/
.envrc.local

# --- Claude Code local memory (user-specific, not repo state) ---
.claude/projects/
