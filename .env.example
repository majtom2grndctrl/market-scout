POSTGRES_DB=your_db_name
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_PORT=5432
DATABASE_URL=postgres://<user>:<password>@localhost:<port>/<db>?sslmode=disable

# Read-only role (market_scout_readonly); used by the MCP server and apps/web
DATABASE_URL_RO=postgres://<user>:<password>@localhost:<port>/<db>?sslmode=disable

# Action role (market_scout_actions); MCP write tools, approved mcp-schema functions only
DATABASE_URL_ACTIONS=postgres://<user>:<password>@localhost:<port>/<db>?sslmode=disable

# Owner DSN for the dedicated test database — <db>_test, not <db>
DATABASE_URL_TEST=postgres://<user>:<password>@localhost:<port>/<db>_test?sslmode=disable

# Read-only role DSN for the test database
DATABASE_URL_TEST_RO=postgres://<user>:<password>@localhost:<port>/<db>_test?sslmode=disable
